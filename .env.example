# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Backend Configuration (Public Anon Key & Project URL)
# Used for authentication, database synchronization, and storage.
# The anon key is safe for public client distribution when RLS is enabled.
# NEVER put service-role or secret keys in this file or the Android app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
